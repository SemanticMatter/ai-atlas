{
  "name": "ai-atlas",
  "version": "1.3.0",
  "private": true,
  "description": "An interactive field guide to AI techniques and their history",
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/prepare-data.mjs",
    "validate": "node scripts/validate.mjs",
    "serve": "python3 -m http.server 8080 --directory dist",
